					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "http://localhost:9000/api/inventory?skuCode=iphone_15&quantity=1",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "9000",
							"path": [
								"api",
								"inventory"
							],
							"query": [
								{
									"key": "skuCode",
									"value": "iphone_15"
								},
								{
									"key": "quantity",
									"value": "1"
								}
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('In stock is true', function () {",
									"    pm.expect(pm.response.text()).to.eql('true');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
