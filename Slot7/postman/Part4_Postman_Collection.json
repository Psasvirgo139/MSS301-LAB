{
	"info": {
		"_postman_id": "b2c3d4e5-part4-collection-mss301",
		"name": "MSS301 - Part 4 Keycloak OAuth2 & API Gateway Security",
		"description": "Postman Collection test cases for Part 4: Keycloak OAuth2 Client Credentials & Secured API Gateway Resource Server.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "token",
			"value": "",
			"type": "string"
		},
		{
			"key": "client_secret",
			"value": "mss301-dev-secret-change-me",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Keycloak OAuth2 Token Tests",
			"item": [
				{
					"name": "T6.4 Keycloak - Get Token (Client Credentials)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/x-www-form-urlencoded"
							}
						],
						"body": {
							"mode": "urlencoded",
							"urlencoded": [
								{
									"key": "grant_type",
									"value": "client_credentials",
									"type": "text"
								},
								{
									"key": "client_id",
									"value": "spring-microservices-client",
									"type": "text"
								},
								{
									"key": "client_secret",
									"value": "{{client_secret}}",
									"type": "text"
								}
							]
						},
						"url": {
							"raw": "http://localhost:8181/realms/spring-microservices-realm/protocol/openid-connect/token",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8181",
							"path": [
								"realms",
								"spring-microservices-realm",
								"protocol",
								"openid-connect",
								"token"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"var jsonData = pm.response.json();",
									"pm.test('Token received', function () {",
									"    pm.expect(jsonData).to.have.property('access_token');",
									"    pm.collectionVariables.set('token', jsonData.access_token);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "T6.6 Keycloak - Get Token Invalid Secret (401)",
					"request": {
