				{
					"name": "T2.1 Inventory - Check In Stock (qty 100)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "http://localhost:8082/api/inventory?skuCode=iphone_15&quantity=100",
							"protocol": "http",
							"host": [
								"localhost"
							],
							"port": "8082",
							"path": [
								"api",
								"inventory"
							],
							"query": [
								{
									"key": "skuCode",
									"value": "iphone_15"
								},
								{
									"key": "quantity",
									"value": "100"
								}
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test('In stock is true', function () {",
									"    pm.expect(pm.response.text()).to.eql('true');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
